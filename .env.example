# Copie para .env e configure a conexão PostgreSQL e as senhas antes de iniciar.
DB_URL=jdbc:postgresql://localhost:5432/suporte
DB_USERNAME=suporte
DB_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@empresa.local
BOOTSTRAP_ADMIN_PASSWORD=
# Desenvolvimento local por HTTP. Em produção HTTPS, use true.
COOKIE_SECURE=false
